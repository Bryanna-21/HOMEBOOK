{
  "expo": {
    "name": "HOMEBOOK",
    "slug": "homebook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/homebook-logo.png",
    "scheme": "homebook",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/homebook-logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050B14",
        "foregroundImage": "./assets/images/homebook-logo.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/homebook-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050B14",
          "image": "./assets/images/homebook-logo.png",
          "imageWidth": 220
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#050B14"
  }
}
